{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "name": "Prefetch API",
  "colors": {
    "primary": "#F7B00A",
    "light": "#F7B00A",
    "dark": "#F7B00A"
  },
  "background": {
    "color": {
      "light": "#FCFBF6",
      "dark": "#1A0618"
    }
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": { "family": "Space Grotesk" },
    "body": { "family": "Inter" }
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/og-background.png",
    "fonts": { "family": "Space Grotesk" }
  },
  "css": "/custom.css",
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/authentication",
              "concepts/credits",
              "concepts/rate-limits",
              "concepts/errors"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Agents",
            "pages": [
              "mcp/overview",
              "mcp/tools"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoint/brand",
              "api-reference/endpoint/classify",
              "api-reference/endpoint/company",
              "api-reference/endpoint/screenshot",
              "api-reference/endpoint/enrich"
            ]
          },
          {
            "group": "Web extraction",
            "pages": [
              "api-reference/endpoint/scrape",
              "api-reference/endpoint/map",
              "api-reference/endpoint/crawl",
              "api-reference/endpoint/crawl-status",
              "api-reference/endpoint/crawl-cancel"
            ]
          }
        ]
      }
    ],
    "global": {
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://prefetch.io/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://prefetch.io/account"
    }
  },
  "contextual": {
    "options": [
      "claude",
      "copy",
      "view",
      "chatgpt",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Website", "href": "https://prefetch.io" },
          { "label": "Brand Catalog", "href": "https://prefetch.io/brands" },
          { "label": "Dashboard", "href": "https://prefetch.io/dashboard" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "API Reference", "href": "/api-reference/introduction" },
          { "label": "MCP Server", "href": "/mcp/overview" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "Book a Demo", "href": "https://cal.com/nestoras.design" },
          { "label": "Contact", "href": "mailto:hi@prefetch.io" },
          { "label": "Privacy", "href": "https://prefetch.io/privacy" },
          { "label": "Terms", "href": "https://prefetch.io/terms" }
        ]
      }
    ]
  }
}
